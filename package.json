{
  "name": "workflow-test",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Repositório de teste do pipeline padrão: CI → bump no PR → release por tag → sync main→develop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.js",
    "check:extenso": "node checks/valor-extenso.check.mjs",
    "check:total": "node checks/total.check.mjs",
    "checks": "npm run check:extenso && npm run check:total"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
